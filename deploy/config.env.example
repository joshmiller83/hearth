# Deploy settings. Copy to deploy/config.env (git-ignored) and adjust for your Mac.
# Every script in deploy/ reads this file.

# The macOS account the relay runs as. It owns the data folder and the gmailkit checkout.
SERVICE_USER=jm

# launchd labels: <prefix>.hearth, <prefix>.hearth-backup, <prefix>.hearth-watchdog
LABEL_PREFIX=com.example

# Where the relay keeps its binary, database, backups, logs, household.json and secrets.
DATA_DIR=/Users/jm/HearthRelay

# The relay only listens on this Mac. Cloudflare Tunnel brings the phone's traffic in.
HOST=127.0.0.1
PORT=8791

# The public name the phone talks to.
PUBLIC_HOSTNAME=hearth.example.com

# The relay's executable product in Relay/Package.swift.
SERVER_PRODUCT=Run

# The gmailkit checkout (accounts.yaml, the encrypted token bundle) and its venv.
GMAILKIT_DIR=/Users/jm/Developer/gh/gmail

# Optional: a file (mode 600) holding the relay's own Anthropic API key, for the
# morning brief and sorting the mail rules can't place. Leave empty until then.
ANTHROPIC_KEY_FILE=

# Optional: push (the 6:30 brief, scheduled sends going out, anything urgent).
# An APNs auth key from developer.apple.com > Keys (Apple Push Notifications
# service), saved as a file (mode 600) the service user can read, plus its Key ID
# and your Team ID. Leave empty until then; the relay runs without push.
APNS_KEY_FILE=
APNS_KEY_ID=
APNS_TEAM_ID=
# "development" while the app is installed from Xcode; "production" for TestFlight.
APNS_ENV=development
# The app's bundle id. Empty means the relay's default.
APNS_TOPIC=

# Optional: message bridges (docs/deploy.md, "Message bridges"). WhatsApp and Facebook
# Messenger reach this Mac through the open-source bridges Beeper maintains (mautrix)
# and a private Matrix homeserver (Synapse). Nothing listens beyond 127.0.0.1 and
# nothing federates. Quoted and space-separated, from: whatsapp facebook, e.g.
# BRIDGES="whatsapp facebook". Empty means none.
BRIDGES=
# Part of every Matrix id (@hearth:<name>). It never leaves this Mac, so it needn't
# resolve, but it can't change once the homeserver is made.
MATRIX_SERVER_NAME=hearth.local
MATRIX_PORT=8008
# Python 3.10 or newer for Synapse (Homebrew's; macOS's own python3 is too old).
MATRIX_PYTHON=/usr/local/bin/python3.13

# Cloudflare Tunnel (only tunnel-add-hostname.sh uses these).
CLOUDFLARED_BIN=/usr/local/bin/cloudflared
# The tunnel's config.yml. This setup adds an ingress rule to an existing tunnel.
CF_CONFIG=/Users/jm/.cloudflared/config.yml
# Tunnel name or id.
CF_TUNNEL=my-tunnel
# launchd label of the daemon that runs cloudflared, so we can print its restart command.
CF_LABEL=com.example.cloudflared
