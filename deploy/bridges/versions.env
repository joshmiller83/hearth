# What deploy/bridges/build.sh builds. Bump these in a commit, then run
# `make bridges` on the Mac (deploy/bridges/update.sh).
#
# The bridges release monthly, mid-month, with calendar tags (v0.2610.0 is
# October 2026): https://mau.fi/blog. Read the release post before bumping, and
# don't skip a month; some releases migrate data that the next one expects.
MAUTRIX_WHATSAPP_VERSION=v0.2610.0
MAUTRIX_META_VERSION=v0.2610.0

# Synapse releases every few weeks: https://github.com/element-hq/synapse/releases
SYNAPSE_VERSION=1.163.2
